# =============================================================================
# Environment variables for the Conversational Recommender System (CRS)
# Copy this file to .env and fill in your values.
# Precedence: env vars > config.yaml > hardcoded defaults
# Nested config keys use __ delimiter (e.g. QDRANT__URL)
# =============================================================================

# --- App ---------------------------------------------------------------------
APP_NAME=Cierge
APP_VERSION=1.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

# --- Rate Limiting -----------------------------------------------------------
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_TIMEOUT=10

# --- Qdrant ------------------------------------------------------------------
QDRANT__URL=http://localhost:6333
QDRANT__API_KEY=
QDRANT__COLLECTION_NAME=crs_data
QDRANT__VECTOR_SIZE=1536

# --- Postgres ----------------------------------------------------------------
POSTGRES__ENABLED=false
POSTGRES__URL=postgresql://user:password@localhost:5432/crs
POSTGRES__SESSION_TTL_SECONDS=7200
POSTGRES__CLEANUP_INTERVAL_SECONDS=600

# --- Debug -------------------------------------------------------------------
DEBUG=false

# --- Graph / Loop limits -----------------------------------------------------
GRAPH_MAX_INPUT_CHARACTERS_PER_MESSAGE=16000
MAIN_LOOP_MAX_ITERATIONS=5
ORCHESTRATOR_AGENT_MAX_ITERATIONS=5

# --- LLM Models --------------------------------------------------------------
# Each model gets a prefix matching the key in config.yaml models dict.
#   MODELS__<KEY>__BASE_URL
#   MODELS__<KEY>__API_KEY
#   MODELS__<KEY>__MODEL_NAME
#   MODELS__<KEY>__REASONING_MODEL
MODELS__OPENAI__BASE_URL=https://api.openai.com/v1
MODELS__OPENAI__API_KEY=sk-...
MODELS__OPENAI__MODEL_NAME=gpt-4o
MODELS__OPENAI__REASONING_MODEL=false

# --- Model Role Assignments --------------------------------------------------
# These reference model keys defined under models: above.
ORCHESTRATOR_MODEL__MODEL=openai
ORCHESTRATOR_MODEL__TEMPERATURE=0.7
ORCHESTRATOR_MODEL__MAX_TOKENS=2048

ASK_MODEL__MODEL=openai
ASK_MODEL__TEMPERATURE=0.7
ASK_MODEL__MAX_TOKENS=2048

RECOMMEND_MODEL__MODEL=openai
RECOMMEND_MODEL__TEMPERATURE=0.7
RECOMMEND_MODEL__MAX_TOKENS=2048

# --- Embedding Model ---------------------------------------------------------
EMBEDDING_MODEL__BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL__API_KEY=sk-...
EMBEDDING_MODEL__MODEL_NAME=text-embedding-3-small

# --- Search ------------------------------------------------------------------
SEARCH_MIN_SCORE_THRESHOLD=0.40

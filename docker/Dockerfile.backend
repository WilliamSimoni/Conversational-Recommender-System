# ── Stage 1: dependency builder ───────────────────────────────────────────────
FROM python:3.13-slim AS builder

WORKDIR /build

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN pip install --upgrade pip

# Install dependencies into an isolated prefix so we can copy them cleanly
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy only what pip needs to resolve & install deps
COPY pyproject.toml README.md ./
COPY src ./src

RUN pip install --prefix=/install .

# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM python:3.13-slim AS runtime

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

# libpq5 is required for psycopg to talk to Postgres
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Create a non-root user for security
RUN addgroup --system appgroup && \
    adduser  --system --ingroup appgroup --no-create-home appuser

# Pull installed packages from builder stage
COPY --from=builder /install /usr/local

# Copy application source (src/ package + entrypoint)
COPY src ./src
COPY main.py ./

# config.yaml and .env are injected at runtime via Docker volume / env_file,
# The paths below are just placeholders so the app can start without errors
# if the volume mount is missing during local dev.
RUN mkdir -p /app && \
    touch /app/config.yaml && \
    touch /app/.env

#Give ownership of the app directory to the non-root user
RUN chown -R appuser:appgroup /app

# Switch to non-root
USER appuser

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]

# Pipeline settings
CATALOG_PATH=data/catalog.json
STAGING_FOLDER=./staging
DEBUG=false

# Embedding model (OpenAI-compatible)
EMBEDDING_MODEL__BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL__API_KEY=
EMBEDDING_MODEL__MODEL_NAME=text-embedding-3-small
EMBEDDING_MODEL__EMBEDDING_BATCH_SIZE=100

# Qdrant vector database
QDRANT__URL=http://localhost:6333
QDRANT__API_KEY=
QDRANT__COLLECTION_NAME=crs_data
QDRANT__VECTOR_SIZE=1536
